# Copy to .env for local `task deps:up` + `task backend:dev`, or for Docker deployment.
# Never commit .env.

# Bearer token Hermes (or any MCP client) sends in the Authorization header to /mcp.
# Leave unset to run without /mcp mounted — the agent still works on its own.
ARGUS_MCP_TOKEN=

# /breakglass has its own login (no token to set here) — the first visit to /login
# generates an admin account and shows the password once. See the README.

# ntfy.sh topic URL for break-glass push notifications. Leave unset to skip pushes.
ARGUS_NTFY_TOPIC_URL=

# Docker deployment only: which Argus config gets bind-mounted into the container.
# Local development always uses examples/argus.dev.yaml (see the Taskfile); this is only for Docker.
CONFIG_FILE=./examples/argus.example.yaml

# Docker host port for the agent and all its interfaces.
# Local development uses port 8421.
ARGUS_PORT=8421

# Postgres for checkpoints/history. The shared Taskfile environment builds a local
# ARGUS_AGENT_DATABASE_URL from this; Compose uses its internal postgres hostname.
# Use a URL-safe password (e.g. generated hexadecimal) for these assembled URLs.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# https://openrouter.ai/keys — one key routes to any model (see agent.model in your
# Argus config, e.g. examples/argus.example.yaml).
OPENROUTER_API_KEY=
