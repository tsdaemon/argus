# Copy to .env.deploy (gitignored) for `task deploy`. Layered on top of .env by
# go-task — only list what actually differs for theseus here.

# LAN-only hostname Traefik routes on theseus. Does not need to resolve off-LAN.
APP_HOSTNAME_LOCAL=argus.theseus.lan

# Deploy secrets get their own keys — never fall back to the local .env value, so
# rotating one never silently rotates the other.
DEPLOY_ARGUS_MCP_TOKEN=

# Password of the one admin account that guards the whole app (username: admin). Required:
# without it the first visitor to /login would pick it. Seeds the account once; to change it
# later, `delete from admin_account` and set the new value.
DEPLOY_ARGUS_ADMIN_PASSWORD=

# Which Argus config gets bind-mounted into the deployed container.
CONFIG_FILE=./examples/theseus.argus.yaml

# Break-glass launcher (breakglass.launcher in that config). Absolute paths on this machine:
# Compose copies both files into the container as secrets, so neither ends up in an image,
# a volume, or git. The key pair is generated once; see docs/breakglass.md.
ARGUS_LAUNCHER_KEY_PATH=/path/to/argus/.ssh/argus_launcher
# Public host keys of every target host, e.g. `ssh-keyscan -t ed25519 host1 host2 > file`.
ARGUS_KNOWN_HOSTS_PATH=/path/to/argus/.ssh/known_hosts
