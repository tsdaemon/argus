# Copy to .env.deploy (gitignored) for `task deploy`. Layered on top of .env by
# go-task — only list what actually differs for theseus here.

# LAN-only hostname Traefik routes on theseus. Does not need to resolve off-LAN.
APP_HOSTNAME_LOCAL=argus.theseus.lan

# Deploy secrets get their own keys — never fall back to the local .env value, so
# rotating one never silently rotates the other.
DEPLOY_ARGUS_MCP_TOKEN=

# Password of the one admin account that guards the whole app (username: admin). Required:
# without it the first visitor to /login would pick it. Seeds the account once; to change it
# later, `delete from admin_account` and set the new value.
DEPLOY_ARGUS_ADMIN_PASSWORD=

# Which Argus config gets bind-mounted into the deployed container.
CONFIG_FILE=./examples/theseus.argus.yaml

# SSH files, as absolute paths on this machine. scripts/theseus-compose.sh reads them and
# Compose copies them into the container as secrets, so none ends up in an image, a volume,
# or git. The key pairs are generated once; see docs/breakglass.md.
# Break-glass launcher key (breakglass.launcher in the config).
ARGUS_LAUNCHER_KEY_PATH=/path/to/argus/.ssh/argus_launcher
# Direct-access key for the ssh provider's hosts (the router, Home Assistant OS).
ARGUS_SSH_KEY_PATH=/path/to/argus/.ssh/argus_ssh
# Host keys of every launcher and ssh host. Copy them from a known_hosts you already trust
# (`ssh-keygen -F host`), not a fresh ssh-keyscan; non-22 ports appear as [host]:port.
ARGUS_KNOWN_HOSTS_PATH=/path/to/argus/.ssh/known_hosts

# Home Assistant long-lived access token for the homeassistant provider. A deploy secret, like
# the SSH key: its own key, never the local .env value. Required. The overlay sets it as the
# container's ARGUS_HA_TOKEN, which the config references.
DEPLOY_ARGUS_HA_TOKEN=

# Host port for Phoenix's trace UI on theseus.
PHOENIX_PORT=6006

# Phoenix login (email `admin@localhost`) and its secrets. PHOENIX_SECRET signs sessions; the admin secret
# is also argus's trace-export token. Both secrets: 32+ characters with a digit and a lowercase
# letter, and different from each other. The password only seeds the admin account on
# Phoenix's first start; change it later in Phoenix.
DEPLOY_PHOENIX_SECRET=
DEPLOY_PHOENIX_ADMIN_SECRET=
DEPLOY_PHOENIX_ADMIN_PASSWORD=

# The container runs as this uid/gid (theseus:users), which owns ARGUS_WORKSPACE_DIR.
ARGUS_UID=1001
ARGUS_GID=100
# Group of /var/run/docker.sock on theseus.
DOCKER_GID=987
# Host directory for the agent's workspace, inside what theseus backs up.
ARGUS_WORKSPACE_DIR=/appdata/argus/workspace
